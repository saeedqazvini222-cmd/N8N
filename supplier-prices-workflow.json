      "typeVersion": 3,
      "position": [
        280,
        60
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.PRODUCT_LIST_URL + ($json.PRODUCT_LIST_URL.includes('?') ? '&' : '?') + 'page=' + $json.page }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
