      "id": "a1f4bc1e-5f31-47d2-a965-000000000003",
      "name": "GET Login Page (CSRF + cookies)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1110,
        140
      ],
      "alwaysOutputData": true
