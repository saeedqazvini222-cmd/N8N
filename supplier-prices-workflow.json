      "id": "a1f4bc1e-5f31-47d2-a965-000000000005",
      "name": "POST Request OTP (mobile number)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        140
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// A 200 response only proves that the HTTP request was accepted; it does NOT prove an SMS was sent.\n// Set OTP_SENT_MARKER to an exact success message/code from the supplier response (for example: \"کد تایید ارسال شد\").\nconst html = String($json.body ?? $json.data ?? JSON.stringify($json));\nconst previous = $('Extract Optional CSRF and Session Cookie').first().json;\nconst failed = /invalid (mobile|phone|number)|too many requests|not registered|rate limit|شماره.*(?:نامعتبر|اشتباه)|خطا در ارسال/i.test(html);\nconst marker = String(previous.OTP_SENT_MARKER ?? '').trim();\nif (failed || (marker && !html.toLowerCase().includes(marker.toLowerCase()))) {\n  return [{ json: { ok: false, reason: marker && !html.toLowerCase().includes(marker.toLowerCase()) ? 'Supplier did not return OTP_SENT_MARKER. The request endpoint or payload is likely incorrect.' : 'OTP request was rejected. Verify OTP_REQUEST_URL, MOBILE_FIELD_NAME, and MOBILE_NUMBER.' } }];\n}\nconst form = html.match(/<form\\b([^>]*)>/i);\nconst action = form?.[1]?.match(/\\baction=[\\\"']([^\\\"']*)/i)?.[1] ?? '';\nconst inputNames = [...html.matchAll(/<input\\b[^>]*\\bname=[\\\"']([^\\\"']+)[\\\"'][^>]*>/gi)].map(m => m[1]);\nconst otpField = inputNames.find(name => /(?:otp|verification|confirm|code|token)/i.test(name)) ?? previous.OTP_FIELD_NAME;\nconst otpVerifyUrl = previous.OTP_VERIFY_URL || (action ? new URL(action, previous.OTP_REQUEST_URL).href : '');\nif (!otpVerifyUrl) return [{ json: { ok: false, reason: 'OTP request completed, but OTP_VERIFY_URL could not be detected. Set OTP_VERIFY_URL explicitly.' } }];\nconst headers = $json.headers ?? {};\nconst fresh = headers['set-cookie'] ?? headers['Set-Cookie'] ?? [];\nconst cookies = (Array.isArray(fresh) ? fresh : [fresh]).map(c => String(c).split(';')[0]).filter(Boolean).join('; ');\nreturn [{ json: { ...previous, OTP_VERIFY_URL: otpVerifyUrl, OTP_FIELD_NAME: otpField, sessionCookie: cookies || previous.sessionCookie, ok: true } }];"
      },
