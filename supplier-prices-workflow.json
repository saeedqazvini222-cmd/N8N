        "jsCode": "const rows = $input.all();\nreturn [{ json: { total_products_collected: rows.length, updated_products: rows.filter(({json}) => json.id).length, new_products: rows.filter(({json}) => !json.id).length, failed_products: 0, completed_at: new Date().toISOString() } }];"
      },
