    {
      "parameters": {
        "jsCode": "// OTP-only pages can have no CSRF token or cookie; both remain optional.\n// If OTP_REQUEST_URL is not configured, use the first login form action discovered on the page.\nconst html = String($json.body ?? $json.data ?? JSON.stringify($json));\nconst cfg = $('Configuration (environment variables)').first().json;\nconst form = html.match(/<form\\b([^>]*)>/i);\nconst action = form?.[1]?.match(/\\baction=[\\\"']([^\\\"']*)/i)?.[1] ?? '';\nconst inputNames = [...html.matchAll(/<input\\b[^>]*\\bname=[\\\"']([^\\\"']+)[\\\"'][^>]*>/gi)].map(m => m[1]);\nconst mobileField = inputNames.find(name => /(mobile|phone|tel|cell|username)/i.test(name)) ?? cfg.MOBILE_FIELD_NAME;\nconst csrf = html.match(/<input[^>]+name=[\\\"'](?:_token|csrf(?:_token)?)[\\\"'][^>]+value=[\\\"']([^\\\"']+)/i)?.[1] ?? '';\nconst headers = $json.headers ?? {};\nconst setCookie = headers['set-cookie'] ?? headers['Set-Cookie'] ?? [];\nconst sessionCookie = (Array.isArray(setCookie) ? setCookie : [setCookie]).map(c => String(c).split(';')[0]).filter(Boolean).join('; ');\nconst otpRequestUrl = cfg.OTP_REQUEST_URL || (action ? new URL(action, cfg.LOGIN_URL).href : '');\nif (!otpRequestUrl) throw new Error('OTP_REQUEST_URL is required: no form action was found on LOGIN_URL');\nreturn [{ json: { ...cfg, OTP_REQUEST_URL: otpRequestUrl, MOBILE_FIELD_NAME: mobileField, csrf, sessionCookie } }];"
      },
      "id": "a1f4bc1e-5f31-47d2-a965-000000000004",
