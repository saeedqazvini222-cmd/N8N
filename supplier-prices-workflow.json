      "id": "a1f4bc1e-5f31-47d2-a965-000000000011",
      "name": "GET Product List Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        60
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Configure supplier-specific data attributes/classes here once. This parser accepts common product-card markup.\nconst html = $json.body ?? $json.data ?? '';\nif (!html || /<title[^>]*>[^<]*(login|error|unavailable)/i.test(html)) throw new Error('Website unavailable, session expired, or page structure changed');\nconst decode = s => String(s ?? '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst fa = '۰۱۲۳۴۵۶۷۸۹', ar = '٠١٢٣٤٥٦٧٨٩';\nconst normalize = value => decode(value).replace(/[٠-٩]/g, d => String(ar.indexOf(d))).replace(/[۰-۹]/g, d => String(fa.indexOf(d))).replace(/ي/g, 'ی').replace(/ك/g, 'ک');\nconst cards = html.match(/<(?:article|li|div)[^>]+(?:product-item|product-card|product)[^>]*>[\\s\\S]*?<\\/(?:article|li|div)>/gi) ?? [];\nconst cfg = $('Paginate Until Empty Page').first().json;\nconst rows = cards.map(card => {\n const field = name => card.match(new RegExp('(?:data-' + name + '|name=[\\\"']' + name + '[\\\"'])=[\\\"']([^\\\"']+)', 'i'))?.[1];\n const text = pattern => decode(card.match(pattern)?.[1]);\n const product_name = normalize(field('name') ?? text(/class=[\\\"'][^\\\"']*(?:product-title|product-name)[^\\\"']*[\\\"'][^>]*>([\\s\\S]*?)<\\//i));\n const product_code = normalize(field('sku') ?? field('code') ?? text(/(?:sku|product-code)[^>]*>([\\s\\S]*?)<\\//i));\n const rawPrice = normalize(field('price') ?? text(/(?:price|amount)[^>]*>([\\s\\S]*?)<\\//i));\n const price = Number(rawPrice.replace(/[^0-9.-]/g, ''));\n const stock = normalize(field('stock') ?? text(/(?:stock|availability)[^>]*>([\\s\\S]*?)<\\//i));\n const href = card.match(/<a[^>]+href=[\\\"']([^\\\"']+)/i)?.[1] ?? '';\n return { supplier_name: cfg.SUPPLIER_NAME, product_name, product_code, price: Number.isFinite(price) ? price : null, stock, product_url: href ? new URL(href, cfg.PRODUCT_LIST_URL).href : '', updated_at: new Date().toISOString() };\n}).filter(row => row.product_name && row.price !== null);\nif (!rows.length) return [];\nreturn rows.map(row => ({ json: row }));"
      },
      "id": "a1f4bc1e-5f31-47d2-a965-000000000012",
