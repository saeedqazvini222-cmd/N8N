    {
      "parameters": {
        "jsCode": "const html = String($json.body ?? $json.data ?? JSON.stringify($json));\nconst failed = /invalid (otp|code)|expired|incorrect code|verification failed/i.test(html);\nconst markers = ['logout', 'dashboard', 'account'];\nif (failed || !markers.some(marker => html.toLowerCase().includes(marker))) {\n  return [{ json: { ok: false, reason: failed ? 'OTP verification failed or the code expired' : 'OTP verification did not reach the authenticated dashboard' } }];\n}\nconst headers = $json.headers ?? {};\nconst fresh = headers['set-cookie'] ?? headers['Set-Cookie'] ?? [];\nconst cookies = (Array.isArray(fresh) ? fresh : [fresh]).map(c => String(c).split(';')[0]).filter(Boolean).join('; ');\nreturn [{ json: { ...$('Validate OTP Request').first().json, sessionCookie: cookies || $('Validate OTP Request').first().json.sessionCookie, ok: true } }];"
      },
