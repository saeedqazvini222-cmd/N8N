    {
      "parameters": {
        "jsCode": "// Data Table must be created once in n8n with these columns: id, supplier_name, product_name, product_code, price, stock, product_url, updated_at.\n// This node emits bounded pages; blank pages are discarded after extraction. Change MAX_PAGES for large catalogs.\nconst cfg = $json;\nreturn Array.from({ length: cfg.MAX_PAGES }, (_, index) => ({ json: { ...cfg, page: index + 1 } }));"
      },
